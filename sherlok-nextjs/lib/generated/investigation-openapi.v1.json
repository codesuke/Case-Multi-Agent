      },
      "Verdict": {
        "description": "The Lead Detective's ranked, evidence-cited proposal.\n\nThis is a proposal only: storing it on the case file does not mean a\nhuman has reviewed or accepted it. `limitations` names any material\nunresolved Skeptic finding or notable uncertainty instead of hiding it.\n`review_status` starts `AWAITING_REVIEW` and is only ever changed by\n`CaseFile.accept_verdict`/`reject_verdict`/`request_reinvestigation`,\nwhich never touch the conclusions, confidence, or limitations recorded\nhere.",
        "properties": {
          "conclusions": {
            "items": {
              "$ref": "#/components/schemas/Conclusion"
            },
            "title": "Conclusions",
            "type": "array"
          },
          "confidence": {
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "integer"
          },
          "limitations": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Limitations",
            "type": "array"
          },
          "review_status": {
            "$ref": "#/components/schemas/VerdictReviewStatus",
            "default": "awaiting_review"
          }
        },
        "required": [
          "conclusions",
          "confidence"
        ],
        "title": "Verdict",
        "type": "object"
      },
      "VerdictReviewStatus": {
        "description": "Whether a proposed verdict still awaits a human decision.",
        "enum": [
          "awaiting_review",
          "accepted",
          "rejected",
          "reinvestigation_requested"
        ],
        "title": "VerdictReviewStatus",
        "type": "string"
      }
    }
  },
  "info": {
    "title": "Sherlok Investigation API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/investigations": {
      "post": {
        "operationId": "start_investigation_v1_investigations_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_start_investigation_v1_investigations_post"
              }
            }
          }
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartedInvestigation"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransportFailure"
                }
              }
            },
            "description": "Bad Request"
          }
