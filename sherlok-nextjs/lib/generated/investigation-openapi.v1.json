      "Claim": {
        "description": "A single motive or opportunity statement.\n\nA `SUPPORTED` claim must cite one or more evidence IDs that exist in the\ncase file. An `UNKNOWN` claim marks the analysis as unresolved rather\nthan presenting a guess as fact.",
        "properties": {
          "evidence_ids": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Evidence Ids",
            "type": "array"
          },
          "statement": {
            "title": "Statement",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ClaimStatus"
          }
        },
        "required": [
          "statement",
          "status"
        ],
        "title": "Claim",
        "type": "object"
      },
      "ClaimStatus": {
        "description": "Whether a specialist claim is backed by cited evidence or unresolved.",
        "enum": [
          "supported",
          "unknown"
        ],
        "title": "ClaimStatus",
        "type": "string"
      },
      "Conclusion": {
        "description": "One ranked, evidence-cited explanation the Lead Detective proposes.\n\nRanks start at 1 and must be unique and consecutive across a verdict's\nconclusions, with 1 the most strongly supported.",
