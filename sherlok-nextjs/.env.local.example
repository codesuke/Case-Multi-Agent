# Server-only URL for the local Python investigation adapter.
# Never use a NEXT_PUBLIC_ variable for this setting.
SHERLOK_PYTHON_API_URL=http://127.0.0.1:8000

# Public canonical URL for SEO metadata, robots.txt, and sitemap.xml.
# Use the production HTTPS origin without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-sherlok-domain.example

# Optional Google Search Console verification token. Add this only after
# creating and verifying the property in Google Search Console.
GOOGLE_SITE_VERIFICATION=
